[Unit]
Description=DarkWatch personal server monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=darkwatch
Group=darkwatch
WorkingDirectory=/opt/darkwatch
EnvironmentFile=/etc/darkwatch/env
ExecStart=/opt/darkwatch/.venv/bin/python -m app.server
Restart=on-failure
RestartSec=4
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/darkwatch
PrivateTmp=true

[Install]
WantedBy=multi-user.target
